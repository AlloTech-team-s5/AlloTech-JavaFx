<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.allotech.controller.AvisTechnicienController"
      spacing="18" style="-fx-background-color: #F4F4F6; -fx-padding: 24;">

    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: #FFFFFF; -fx-background-radius: 14; -fx-padding: 20;">
        <VBox spacing="4">
            <Label text="Avis reçus et score"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #351C4D;"/>
            <Label fx:id="lblNombreAvis" text="0 avis vérifiés"
                   style="-fx-font-size: 13px; -fx-text-fill: #6B6575;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER"
              style="-fx-background-color: #F6D5F7; -fx-background-radius: 12; -fx-padding: 12 20;">
            <Label text="Score moyen" style="-fx-font-size: 12px; -fx-text-fill: #351C4D;"/>
            <Label fx:id="lblScoreMoyen" text="0.00 ★ / 5"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #351C4D;"/>
        </VBox>
    </HBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS"
          style="-fx-background-color: #FFFFFF; -fx-background-radius: 14; -fx-padding: 20;">
        <Label text="Commentaires des clients"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #351C4D;"/>
        <ListView fx:id="listAvisRecus" VBox.vgrow="ALWAYS"/>
    </VBox>

</VBox>